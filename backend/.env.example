PORT=5000

# --- MongoDB (Modelo B) ---
# DB global administrativa (tenants, roles, auditoría)
MONGO_URL_GLOBAL=mongodb://localhost:27017/duckhub_admin

# --- Auth/JWT ---
JWT_SECRET=CHANGE_THIS_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_ISSUER=duckhack-cloud-backend
JWT_AUDIENCE=duckhack-cloud-clients
JWT_ACCESS_EXPIRES_IN=1h
JWT_EMAIL_VERIFY_EXPIRES_IN=24h

# --- Email contacto ---
EMAIL_CONTACT_HOST=XXXX
EMAIL_CONTACT_PORT=587
EMAIL_CONTACT_USER=contacto@duck-hack.com
EMAIL_CONTACT_PASS=xxxxxx

# --- Email para envio de codigos ---
EMAIL_CODES_HOST=XXXX
EMAIL_CODES_PORT=587
EMAIL_CODES_USER=no-reply@duck-hack.com
EMAIL_CODES_PASS=xxxxxx

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:82,http://localhost:89
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_LOCAL_DEV=false

# --- Uploads ---
UPLOADS_DIR=/tmp/media-uploads

# --- Datos de la compañía ---
COMPANY_NAME=NombreDeLaCompañiaParaCorreos

# --- Parametros para API INEGI ---
INEGI_URL_API=urlparaconsumirapideinegi
INEGI_APIKEY=apikeyproporcionadaporinegi
INEGI_TYPE_RESPONSE=json/xml
INEGI_NUM_RESULTS=numeroderesultados/10
INEGI_PROJ_TYPE=GRS80/MERC
INEGI_NUM_SCALE=escalarequeridapararutas/1000
